# Hugging Face read token. Never commit the real value.
# Accept gated-model licenses (e.g. Gemma) on huggingface.co before Phase 2.
HF_TOKEN=

# Do NOT set MODAL_TOKEN_ID or MODAL_TOKEN_SECRET.
# Those env vars override profiles and can point at the wrong account.
# Use: uv run modal token new --profile heyronith
#      uv run modal profile activate heyronith
