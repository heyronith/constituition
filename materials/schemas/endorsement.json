{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "endorsement",
  "type": "object",
  "additionalProperties": false,
  "required": ["ratings"],
  "properties": {
    "ratings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rating"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "rating": {"type": "integer", "minimum": 1, "maximum": 7}
        }
      }
    }
  }
}
